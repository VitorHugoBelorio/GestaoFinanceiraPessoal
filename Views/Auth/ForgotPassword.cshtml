@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Recuperar senha";
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <div class="card shadow-sm mt-5">
            <div class="card-body">
                <h4 class="text-center mb-4">Recuperar senha</h4>

                <p class="text-muted small">
                    Informe seu usuário. Em um cenário real, enviaremos instruções por e-mail.
                </p>

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Usuário</label>
                        <input name="username" class="form-control" required />
                    </div>

                    <button class="btn btn-dark w-100">
                        Continuar
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a href="/auth/login" class="text-decoration-none">
                        Voltar ao login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
