@{
    ViewData["Title"] = "Dashboard";
    decimal saldo = ViewBag.Saldo;
}

<h3 class="mb-4">Resumo do mês</h3>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <small class="text-muted">Receitas</small>
                <h4 class="text-success">
                    R$ @ViewBag.TotalReceitas.ToString("N2")
                </h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <small class="text-muted">Despesas</small>
                <h4 class="text-danger">
                    R$ @ViewBag.TotalDespesas.ToString("N2")
                </h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <small class="text-muted">Saldo</small>
                <h4 class="@(saldo >= 0 ? "text-success" : "text-danger")">
                    R$ @saldo.ToString("N2")
                </h4>
            </div>
        </div>
    </div>
</div>

<h5>Últimas despesas</h5>

<table class="table table-sm table-hover">
    <thead>
        <tr>
            <th>Data</th>
            <th>Categoria</th>
            <th>Valor</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in ViewBag.Ultimas)
        {
            <tr>
                <td>@item.Data.ToString("dd/MM/yyyy")</td>
                <td>@item.Categoria?.Nome</td>
                <td class="text-danger">R$ @item.Valor.ToString("N2")</td>
            </tr>
        }
    </tbody>
</table>
