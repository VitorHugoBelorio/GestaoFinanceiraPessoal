@{
    ViewData["Title"] = "Dashboard";
    decimal saldo = ViewBag.Saldo;
}

<div class="container mt-4">

    <!-- Título -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0">Resumo do mês</h3>
            <small class="text-muted">
                @ViewBag.Mes/@ViewBag.Ano
            </small>
        </div>
    </div>

    <!-- Cards principais -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Receitas</small>
                    <h4 class="text-success mb-0">
                        R$ @ViewBag.TotalReceitas.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Despesas</small>
                    <h4 class="text-danger mb-0">
                        R$ @ViewBag.TotalDespesas.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <small class="text-muted">Saldo</small>
                    <h4 class="@(saldo >= 0 ? "text-success" : "text-danger") mb-0">
                        R$ @saldo.ToString("N2")
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Ações rápidas -->
    <h5 class="mb-3">Ações rápidas</h5>

    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <h6 class="mb-2">Nova Receita</h6>
                    <p class="text-muted small">
                        Registrar uma entrada financeira
                    </p>
                    <a href="/receitas/create" class="btn btn-success btn-sm w-100">
                        Adicionar receita
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <h6 class="mb-2">Nova Despesa</h6>
                    <p class="text-muted small">
                        Registrar um gasto
                    </p>
                    <a href="/despesas/create" class="btn btn-danger btn-sm w-100">
                        Adicionar despesa
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 text-center h-100">
                <div class="card-body">
                    <h6 class="mb-2">Categorias</h6>
                    <p class="text-muted small">
                        Gerenciar categorias financeiras
                    </p>
                    <a href="/categorias" class="btn btn-outline-dark btn-sm w-100">
                        Ver categorias
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimas despesas -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">Últimas despesas</h5>
        <a href="/despesas" class="text-decoration-none small">
            Ver todas →
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Categoria</th>
                        <th class="text-end">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewBag.Ultimas.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-3">
                                Nenhuma despesa registrada neste mês
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in ViewBag.Ultimas)
                        {
                            <tr>
                                <td>@item.Data.ToString("dd/MM/yyyy")</td>
                                <td>@item.Categoria?.Nome</td>
                                <td class="text-danger text-end">
                                    R$ @item.Valor.ToString("N2")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
