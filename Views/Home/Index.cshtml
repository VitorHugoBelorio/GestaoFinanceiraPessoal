@model DashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";
    var saldo = Model.Saldo;
    var periodoAtual = new DateTime(Model.Ano, Model.Mes, 1);
    var mesAnterior = periodoAtual.AddMonths(-1);
    var proximoMes = periodoAtual.AddMonths(1);
    var cultura = new CultureInfo("pt-BR");
}

<div class="hero">
    <div class="mb-5">
        <small class="text-muted">Bem-vindo de volta</small>
        <h1>Seu Panorama Financeiro</h1>
        <p class="text-muted">@periodoAtual.ToString("MMMM 'de' yyyy", cultura)</p>
        <div class="d-flex gap-3 flex-wrap mt-3">
            <a asp-controller="Home" asp-action="Index" asp-route-ano="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month" class="btn btn-outline-dark btn-sm">
                <i class="bi bi-arrow-left"></i> @mesAnterior.ToString("MMM", cultura)
            </a>
            <a asp-controller="Home" asp-action="Index" asp-route-ano="@DateTime.Today.Year" asp-route-mes="@DateTime.Today.Month" class="btn btn-outline-primary btn-sm">
                Hoje
            </a>
            <a asp-controller="Home" asp-action="Index" asp-route-ano="@proximoMes.Year" asp-route-mes="@proximoMes.Month" class="btn btn-outline-dark btn-sm">
                @proximoMes.ToString("MMM", cultura) <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card card-accent-green">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <small class="text-muted">RECEITAS</small>
                        <h4 class="text-success mb-0">R$ @Model.TotalReceitas.ToString("N2")</h4>
                    </div>
                    <i class="bi bi-arrow-up-circle" style="color: var(--accent-green); font-size: 2rem;"></i>
                </div>
                <p class="small text-muted mb-0">Entradas do mes</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-accent-red">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <small class="text-muted">DESPESAS</small>
                        <h4 class="text-danger mb-0">R$ @Model.TotalDespesas.ToString("N2")</h4>
                    </div>
                    <i class="bi bi-arrow-down-circle" style="color: var(--accent-red); font-size: 2rem;"></i>
                </div>
                <p class="small text-muted mb-0">Saidas do mes</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-accent-blue">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <small class="text-muted">SALDO</small>
                        <h4 class="@(saldo >= 0 ? "text-success" : "text-danger") mb-0">R$ @saldo.ToString("N2")</h4>
                    </div>
                    <i class="bi bi-wallet" style="@(saldo >= 0 ? "color: var(--accent-green);" : "color: var(--accent-red);") font-size: 2rem;"></i>
                </div>
                <p class="small text-muted mb-0">Diferenca do periodo</p>
            </div>
        </div>
    </div>
</div>

<div class="mb-5">
    <h5 class="mb-4" style="font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px;">Acoes Rapidas</h5>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-accent-green text-center">
                <div class="card-body">
                    <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--accent-green);">
                        <i class="bi bi-plus-circle-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Nova Receita</h6>
                    <p class="text-muted small mb-3">Registrar uma entrada financeira</p>
                    <a class="btn btn-success w-100" href="/receitas/novo">
                        <i class="bi bi-plus"></i> Adicionar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-accent-red text-center">
                <div class="card-body">
                    <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--accent-red);">
                        <i class="bi bi-dash-circle-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Nova Despesa</h6>
                    <p class="text-muted small mb-3">Registrar um gasto</p>
                    <a href="/despesas/novo" class="btn btn-danger w-100">
                        <i class="bi bi-plus"></i> Adicionar
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-accent-blue text-center">
                <div class="card-body">
                    <div style="font-size: 3rem; margin-bottom: 1rem; color: var(--accent-blue);">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Categorias</h6>
                    <p class="text-muted small mb-3">Gerenciar categorias financeiras</p>
                    <a asp-controller="Categoria" asp-action="Index" class="btn btn-outline-dark w-100">
                        <i class="bi bi-arrow-right"></i> Ver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 style="font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0;">Ultimas Despesas</h5>
        <a href="/despesas" class="text-decoration-none" style="color: var(--accent-blue); font-weight: 600;">
            Ver todas <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Descricao</th>
                        <th>Categoria</th>
                        <th>Status</th>
                        <th class="text-end">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.UltimasDespesas.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.3;"></i>
                                <p class="mt-2 mb-0">Nenhuma despesa registrada neste mes</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.UltimasDespesas)
                        {
                            var corStatus = item.Status == StatusDespesa.Pago ? "var(--accent-green)" : "var(--accent-red)";
                            <tr>
                                <td>@item.Data.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @item.Descricao
                                    @if (item.Recorrente)
                                    {
                                        <span class="badge" style="background-color: var(--accent-blue); opacity: 0.2; color: var(--accent-blue); margin-left: 0.5rem;">FIXA</span>
                                    }
                                </td>
                                <td>@item.CategoriaNome</td>
                                <td>
                                    <span class="badge" style="background-color: @corStatus; opacity: 0.2; color: @corStatus;">@item.Status</span>
                                </td>
                                <td class="text-danger text-end fw-bold">R$ @item.Valor.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .hero {
        padding: 4rem 0;
    }
</style>
