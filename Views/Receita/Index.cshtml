@model IEnumerable<GestaoFinanceiraPessoal.Models.Receita>

@{
    ViewData["Title"] = "Receitas";
    var total = Model?.Sum(m => m.Valor) ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <small class="text-muted">Total</small>
        <h4 class="text-success mb-0">R$ @total.ToString("N2")</h4>
    </div>

    <a class="btn btn-success" href="/receitas/novo">Nova receita</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Data</th>
                    <th>Descrição</th>
                    <th class="text-end">Valor</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">Nenhuma receita registrada</td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Data.ToString("dd/MM/yyyy")</td>
                            <td>
                                @r.Descricao
                                @if (r.RecorrenciaId != null)
                                {
                                    <span class="badge bg-secondary ms-2">Fixa</span>
                                }
                            </td>
                            <td class="text-success text-end">R$ @r.Valor.ToString("N2")</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary me-2" href="/receitas/editar/@r.Id">Editar</a>
                                <a class="btn btn-sm btn-outline-danger js-delete" href="/receitas/excluir/@r.Id">Excluir</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>