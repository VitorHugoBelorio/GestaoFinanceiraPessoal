@model ReceitaIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Receitas";
    var periodoAtual = new DateTime(Model.Ano, Model.Mes, 1);
    var mesAnterior = periodoAtual.AddMonths(-1);
    var proximoMes = periodoAtual.AddMonths(1);
    var cultura = new CultureInfo("pt-BR");
}

<div class="py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 style="font-weight: 900; font-size: 2.5rem;">Receitas</h1>
            <p class="text-muted mb-0">
                Total:
                <span class="text-success fw-bold">R$ @Model.Total.ToString("N2")</span>
            </p>
            <div class="d-flex gap-3 flex-wrap mt-3">
                <a asp-controller="Receita" asp-action="Index" asp-route-ano="@mesAnterior.Year" asp-route-mes="@mesAnterior.Month" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-arrow-left"></i> @mesAnterior.ToString("MMM", cultura)
                </a>
                <span class="text-muted align-self-center">@periodoAtual.ToString("MMMM 'de' yyyy", cultura)</span>
                <a asp-controller="Receita" asp-action="Index" asp-route-ano="@proximoMes.Year" asp-route-mes="@proximoMes.Month" class="btn btn-outline-dark btn-sm">
                    @proximoMes.ToString("MMM", cultura) <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary" asp-controller="Receita" asp-action="Index" asp-route-ano="@Model.Ano" asp-route-mes="@Model.Mes" asp-route-exibirCanceladas="@(Model.ExibirCanceladas ? "false" : "true")">
                <i class="bi @(Model.ExibirCanceladas ? "bi-eye-slash" : "bi-eye")"></i>
                @(Model.ExibirCanceladas ? "Ocultar canceladas" : "Mostrar canceladas")
            </a>
            <a class="btn btn-success" asp-controller="Receita" asp-action="Create">
                <i class="bi bi-plus-circle"></i> Nova Receita
            </a>
        </div>
    </div>

    @if (!Model.Itens.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3; color: var(--text-light);"></i>
                <h5 class="mt-3 mb-2">Nenhuma receita registrada</h5>
                <p class="text-muted mb-4">Comece adicionando uma nova receita</p>
                <a class="btn btn-success" asp-controller="Receita" asp-action="Create">
                    <i class="bi bi-plus"></i> Adicionar Receita
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Descricao</th>
                            <th class="text-end">Valor</th>
                            <th class="text-end">Acao</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var receita in Model.Itens)
                        {
                            var classeLinha = receita.OcorrenciaCancelada ? "table-secondary" : string.Empty;
                            var classeValor = receita.OcorrenciaCancelada ? "text-muted text-end fw-bold text-decoration-line-through" : "text-success text-end fw-bold";

                            <tr class="@classeLinha">
                                <td><span class="fw-bold">@receita.DataExibicao.ToString("dd/MM/yyyy")</span></td>
                                <td>
                                    <span class="@(receita.OcorrenciaCancelada ? "text-muted text-decoration-line-through" : string.Empty)">@receita.Descricao</span>
                                    @if (receita.Recorrente)
                                    {
                                        <span class="badge" style="background-color: var(--accent-blue); opacity: 0.2; color: var(--accent-blue); margin-left: 0.5rem;">FIXA</span>
                                    }
                                    @if (receita.OcorrenciaCancelada)
                                    {
                                        <span class="badge bg-secondary ms-2">CANCELADA</span>
                                    }
                                </td>
                                <td class="@classeValor">R$ @receita.Valor.ToString("N2")</td>
                                <td class="text-end">
                                    @if (receita.OcorrenciaCancelada)
                                    {
                                        <form method="post" asp-controller="Receita" asp-action="Restore" asp-route-id="@receita.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-arrow-counterclockwise"></i> Restaurar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        @if (receita.Recorrente)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary me-2" asp-controller="Receita" asp-action="EditSeries" asp-route-id="@receita.Id">
                                                <i class="bi bi-arrow-repeat"></i> Serie
                                            </a>
                                        }
                                        <a class="btn btn-sm btn-outline-primary me-2" asp-controller="Receita" asp-action="Edit" asp-route-id="@receita.Id">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a class="btn btn-sm btn-outline-danger js-delete" asp-controller="Receita" asp-action="Delete" asp-route-id="@receita.Id">
                                            <i class="bi bi-trash"></i> Excluir
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
