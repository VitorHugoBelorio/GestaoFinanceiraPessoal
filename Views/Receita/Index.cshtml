@model IEnumerable<GestaoFinanceiraPessoal.Models.Receita>

@{
    ViewData["Title"] = "Receitas";
    var total = Model?.Sum(m => m.Valor) ?? 0m;
}

<div class="py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 style="font-weight: 900; font-size: 2.5rem;">Receitas</h1>
            <p class="text-muted mb-0">
                Total:
                <span class="text-success fw-bold">R$ @total.ToString("N2")</span>
            </p>
        </div>
        <a class="btn btn-success" href="/receitas/novo">
            <i class="bi bi-plus-circle"></i> Nova Receita
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3; color: var(--text-light);"></i>
                <h5 class="mt-3 mb-2">Nenhuma receita registrada</h5>
                <p class="text-muted mb-4">Comece adicionando uma nova receita</p>
                <a class="btn btn-success" href="/receitas/novo">
                    <i class="bi bi-plus"></i> Adicionar Receita
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Descrição</th>
                            <th class="text-end">Valor</th>
                            <th class="text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold">@r.Data.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>
                                    @r.Descricao
                                    @if (r.RecorrenciaId != null)
                                    {
                                        <span class="badge" style="background-color: var(--accent-blue); opacity: 0.2; color: var(--accent-blue); margin-left: 0.5rem;">
                                            FIXA
                                        </span>
                                    }
                                </td>
                                <td class="text-success text-end fw-bold">R$ @r.Valor.ToString("N2")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary me-2" href="/receitas/editar/@r.Id">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a class="btn btn-sm btn-outline-danger" href="/receitas/excluir/@r.Id" onclick="return confirm('Tem certeza que deseja excluir?')">
                                        <i class="bi bi-trash"></i> Excluir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>