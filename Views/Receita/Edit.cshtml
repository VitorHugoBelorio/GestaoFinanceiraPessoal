@model ReceitaFormViewModel
@using System.Globalization

@{
    var editandoSerie = ViewBag.EditandoSerie is bool value && value;
    var editandoSomenteProximas = ViewBag.EditandoSomenteProximas is bool somenteProximas && somenteProximas;
    var competenciaOrigem = ViewBag.CompetenciaOrigem is DateTime data ? data : Model.Data;
    var competenciaBase = ViewBag.CompetenciaBase is DateTime dataBase ? dataBase : Model.Data;
    var cultura = new CultureInfo("pt-BR");
    var titulo = editandoSerie
        ? editandoSomenteProximas ? "Editar Proximas Competencias de Receita" : "Editar Serie de Receita"
        : "Editar Receita";
    var descricao = editandoSerie
        ? editandoSomenteProximas
            ? "Preserve esta competencia e aplique as alteracoes somente nas proximas geracoes da serie."
            : "Atualize esta competencia e as proximas geracoes da serie."
        : "Atualize os dados da competencia selecionada.";
    var formAction = editandoSerie
        ? editandoSomenteProximas ? "EditFutureSeries" : "EditSeries"
        : "Edit";
    var mensagemConfirmacao = editandoSomenteProximas
        ? "Deseja encerrar esta serie recorrente apos a competencia atual?"
        : "Deseja encerrar esta serie recorrente a partir desta competencia?";

    ViewData["Title"] = titulo;
}

<div class="py-5">
    <div class="mb-4">
        <h1 style="font-weight: 900; font-size: 2.25rem;">@titulo</h1>
        <p class="text-muted mb-0">@descricao</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-controller="Receita" asp-action="@formAction" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                @if (editandoSerie)
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <span>
                            @if (editandoSomenteProximas)
                            {
                                <text>As alteracoes desta tela preservam a competencia atual e passam a valer a partir de <strong>@competenciaBase.ToString("dd/MM/yyyy")</strong>.</text>
                            }
                            else
                            {
                                <text>As alteracoes desta tela atualizam esta competencia e as proximas geracoes da serie. A data base deve permanecer em <strong>@competenciaOrigem.ToString("MMMM 'de' yyyy", cultura)</strong>.</text>
                            }
                        </span>
                        <a asp-controller="Receita" asp-action="@(editandoSomenteProximas ? "EditSeries" : "EditFutureSeries")" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-arrow-left-right"></i> @(editandoSomenteProximas ? "Incluir esta competencia" : "Editar so proximas")
                        </a>
                    </div>
                }
                else if (Model.ExibirAvisoEdicaoCompetencia)
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <span>Este lancamento pertence a uma serie recorrente. Esta edicao altera somente esta competencia.</span>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-controller="Receita" asp-action="EditSeries" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-arrow-repeat"></i> Esta e proximas
                            </a>
                            <a asp-controller="Receita" asp-action="EditFutureSeries" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-chevron-double-right"></i> So proximas
                            </a>
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label">Descricao</label>
                    <input asp-for="Descricao" class="form-control" />
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Valor" class="form-label">Valor</label>
                    <input asp-for="Valor" class="form-control js-currency" />
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Data" class="form-label">@(editandoSerie ? "Data da competencia base" : "Data")</label>
                    <input asp-for="Data" type="date" class="form-control" />
                    <span asp-validation-for="Data" class="text-danger small"></span>
                </div>

                @if (editandoSerie || Model.PermiteEditarConfiguracaoRecorrencia)
                {
                    <div class="card border-0" style="background-color: #f8fafc;">
                        <div class="card-body">
                            @if (editandoSerie)
                            {
                                <input type="hidden" asp-for="Recorrente" value="true" />
                                <p class="text-muted mb-3">Configure como a serie deve continuar a partir desta competencia.</p>
                            }
                            else
                            {
                                <div class="form-check mb-3">
                                    <input asp-for="Recorrente" class="form-check-input" />
                                    <label asp-for="Recorrente" class="form-check-label">Receita fixa (gera competencias mensais)</label>
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label asp-for="RecorrenciaTipo" class="form-label">Tipo</label>
                                    <select asp-for="RecorrenciaTipo" class="form-select">
                                        @foreach (var tipo in RecorrenciaTipos.Todos)
                                        {
                                            <option value="@tipo">@tipo</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="RecorrenciaIntervalo" class="form-label">Intervalo</label>
                                    <input asp-for="RecorrenciaIntervalo" type="number" min="1" class="form-control" />
                                    <span asp-validation-for="RecorrenciaIntervalo" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="RecorrenciaDataFim" class="form-label">Data final</label>
                                    <input asp-for="RecorrenciaDataFim" type="date" class="form-control" />
                                    <span asp-validation-for="RecorrenciaDataFim" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="Recorrente" />
                    <input type="hidden" asp-for="RecorrenciaTipo" />
                    <input type="hidden" asp-for="RecorrenciaIntervalo" />
                    <input type="hidden" asp-for="RecorrenciaDataFim" />
                }

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">@(editandoSerie ? "Salvar serie" : "Salvar")</button>
                    <a asp-controller="Receita" asp-action="Index" asp-route-ano="@Model.Data.Year" asp-route-mes="@Model.Data.Month" class="btn btn-secondary ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    @if (editandoSerie)
    {
        <div class="card border-danger mt-4">
            <div class="card-body">
                <h2 class="h5 text-danger">Encerrar serie</h2>
                <p class="text-muted mb-3">
                    @(editandoSomenteProximas
                        ? "Essa acao preserva esta competencia e interrompe as proximas geracoes da serie."
                        : "Essa acao cancela esta competencia e interrompe as proximas geracoes da serie.")
                </p>

                <form method="post" asp-controller="Receita" asp-action="@(editandoSomenteProximas ? "EndSeriesAfterCurrent" : "EndSeries")" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('@mensagemConfirmacao');">
                        @(editandoSomenteProximas
                            ? "Encerrar serie apos esta competencia"
                            : "Encerrar serie a partir desta competencia")
                    </button>
                </form>
            </div>
        </div>
    }
</div>
