@model DespesaFormViewModel

@{
    ViewData["Title"] = "Nova Despesa";
    var categorias = (IEnumerable<Categoria>)ViewBag.Categorias;
}

<div class="py-5">
    <div class="mb-4">
        <h1 style="font-weight: 900; font-size: 2.25rem;">Nova Despesa</h1>
        <p class="text-muted mb-0">Registre um gasto e acompanhe o status de pagamento.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-controller="Despesa" asp-action="Create">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label">Descricao</label>
                    <input asp-for="Descricao" class="form-control" />
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Valor" class="form-label">Valor</label>
                    <input asp-for="Valor" class="form-control js-currency" />
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Data" class="form-label">Data</label>
                        <input asp-for="Data" type="date" class="form-control" />
                        <span asp-validation-for="Data" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var status in StatusDespesa.Todos)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="CategoriaId" class="form-label">Categoria</label>
                    <select asp-for="CategoriaId" class="form-select">
                        <option value="0">Selecione uma categoria</option>
                        @foreach (var categoria in categorias)
                        {
                            <option value="@categoria.Id">@categoria.Nome</option>
                        }
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                @if (!categorias.Any())
                {
                    <div class="alert alert-warning mb-3">
                        Voce ainda nao possui categorias cadastradas.
                        <a asp-controller="Categoria" asp-action="Create" class="fw-bold text-decoration-none">Criar categoria</a>
                    </div>
                }

                <div class="card border-0" style="background-color: #f8fafc;">
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input asp-for="Recorrente" class="form-check-input" />
                            <label asp-for="Recorrente" class="form-check-label">Despesa fixa (gera competencias mensais)</label>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="RecorrenciaTipo" class="form-label">Tipo</label>
                                <select asp-for="RecorrenciaTipo" class="form-select">
                                    @foreach (var tipo in RecorrenciaTipos.Todos)
                                    {
                                        <option value="@tipo">@tipo</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RecorrenciaIntervalo" class="form-label">Intervalo</label>
                                <input asp-for="RecorrenciaIntervalo" type="number" min="1" class="form-control" />
                                <span asp-validation-for="RecorrenciaIntervalo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RecorrenciaDataFim" class="form-label">Data final</label>
                                <input asp-for="RecorrenciaDataFim" type="date" class="form-control" />
                                <span asp-validation-for="RecorrenciaDataFim" class="text-danger small"></span>
                            </div>
                        </div>
                        <p class="text-muted small mb-0 mt-3">As configuracoes acima so sao usadas quando a despesa for marcada como recorrente.</p>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-danger">Salvar</button>
                    <a asp-controller="Despesa" asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
