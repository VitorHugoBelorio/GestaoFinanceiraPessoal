@model GestaoFinanceiraPessoal.Models.Despesa

<h3>Nova despesa</h3>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Descrição</label>
        <input asp-for="Descricao" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Valor</label>
        <input asp-for="Valor" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Data</label>
        <input asp-for="Data" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Categoria</label>
        <select asp-for="CategoriaId" class="form-select">
            @foreach (var c in ViewBag.Categorias)
            {
                <option value="@c.Id">@c.Nome</option>
            }
        </select>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="recorrente" />
        <label class="form-check-label">Despesa fixa (recorrente)</label>
    </div>

    <button class="btn btn-dark">Salvar</button>
    <a href="/despesas" class="btn btn-secondary">Cancelar</a>
</form>
