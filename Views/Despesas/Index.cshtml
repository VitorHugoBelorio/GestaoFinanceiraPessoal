@model IEnumerable<GestaoFinanceiraPessoal.Models.Despesa>

<div class="py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 style="font-weight: 900; font-size: 2.5rem;">Despesas</h1>
            <p class="text-muted mb-0">Controle de gastos mensais</p>
        </div>
        <a class="btn btn-danger" href="/despesas/novo">
            <i class="bi bi-plus-circle"></i> Nova Despesa
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-inbox" style="font-size: 3rem; opacity: 0.3; color: var(--text-light);"></i>
                <h5 class="mt-3 mb-2">Nenhuma despesa registrada</h5>
                <p class="text-muted mb-4">Comece adicionando uma nova despesa</p>
                <a class="btn btn-danger" href="/despesas/novo">
                    <i class="bi bi-plus"></i> Adicionar Despesa
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Descrição</th>
                            <th>Categoria</th>
                            <th class="text-end">Valor</th>
                            <th class="text-end">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold">@d.Data.ToString("dd/MM/yyyy")</span>
                                </td>
                                <td>@d.Descricao</td>
                                <td>
                                    <span class="badge" style="background-color: var(--accent-red); opacity: 0.2; color: var(--accent-red);">
                                        @d.Categoria?.Nome
                                    </span>
                                </td>
                                <td class="text-danger text-end fw-bold">
                                    R$ @d.Valor.ToString("N2")
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-danger" href="/despesas/@d.Id/excluir" onclick="return confirm('Tem certeza que deseja excluir?')">
                                        <i class="bi bi-trash"></i> Excluir
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
