@model GestaoFinanceiraPessoal.Models.Categoria

@{
    ViewData["Title"] = "Nova Categoria";
}

<div class="py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="font-weight: 900; font-size: 2.25rem;">Nova Categoria</h1>
            <p class="text-muted mb-0">Crie uma categoria para organizar seus gastos.</p>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-controller="Categoria" asp-action="Create">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Nome" class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-outline-dark">Salvar</button>
                <a asp-controller="Categoria" asp-action="Index" class="btn btn-secondary ms-2">Cancelar</a>
            </form>
        </div>
    </div>
</div>
