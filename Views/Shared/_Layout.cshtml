<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestão Financeira</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background-color: #f5f7fa;
        }

        .navbar-brand {
            font-weight: bold;
            letter-spacing: .5px;
        }

        .nav-link.active {
            font-weight: 600;
            border-bottom: 2px solid #0d6efd;
        }

        footer {
            font-size: .9rem;
        }
    </style>

</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">

            <a class="navbar-brand" href="/">Gestão Financeira</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">

                <!-- MENU ESQUERDO -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path == "/" ? "active" : "")" href="/">Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path.StartsWithSegments("/receitas") ? "active" : "")" href="/receitas">Receitas</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path.StartsWithSegments("/despesas") ? "active" : "")" href="/despesas">Despesas</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @(Context.Request.Path.StartsWithSegments("/categorias") ? "active" : "")" href="/categorias">Categorias</a>
                    </li>
                </ul>

                <!-- MENU DIREITO (USUÁRIO) -->
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> Conta
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/perfil">Meu Perfil</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item text-danger" href="/auth/logout">Sair</a></li>
                        </ul>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <!-- CONTEÚDO -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            Sistema de Gestão Financeira Pessoal — 2025
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
