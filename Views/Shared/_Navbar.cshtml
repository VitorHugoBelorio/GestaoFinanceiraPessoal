@{ var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLowerInvariant() ?? string.Empty; }
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <!-- Logo / Nome do sistema -->
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <i class="bi bi-cash-coin"></i> GFP
        </a>

        <!-- Botão mobile -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list"></i>
        </button>

        <!-- Conteúdo -->
        <div class="collapse navbar-collapse" id="navbarContent">
            <!-- Menu no centro -->
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "home" ? "active" : "")" asp-controller="Home" asp-action="Index">Dashboard</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "receita" ? "active" : "")" href="/receitas">Receitas</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "despesa" ? "active" : "")" asp-controller="Despesa" asp-action="Index">Despesas</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentController == "categoria" ? "active" : "")" asp-controller="Categoria" asp-action="Index">Categorias</a>
                </li>
            </ul>

            <!-- Área do usuário (direita) -->
            <ul class="navbar-nav ms-auto align-items-center">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <li class="nav-item dropdown me-3">
                        <a class="nav-link dropdown-toggle d-flex align-items-center"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <i class="bi bi-person-circle me-2"></i>
                            <span>@User.Identity.Name</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="/auth/logout">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Sair
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="btn btn-primary" asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i> Entrar
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
